# Copy to .env and fill in. Every value here is a placeholder; never commit real secrets.

# --- Public URL of this server (ngrok / Cloudflare Tunnel / your domain) ---
PUBLIC_URL=https://your-agent.example.com

# --- Twilio (https://console.twilio.com) ---
# The auth token validates webhooks (X-Twilio-Signature), authorises hang-up/transfer and SMS.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Staff line for transfer_to_human (E.164, e.g. +97140000000). Empty = take a message instead.
TRANSFER_NUMBER=

# --- Business profile: bundled "restaurant" / "clinic" (fictional samples) or a path to your YAML ---
PROFILE=restaurant
# Override the profile's speaking style: gulf (Emirati/Khaleeji) or msa (Modern Standard Arabic)
DIALECT=

# --- LLM: mock | openai | openrouter | groq | ollama | lmstudio | anthropic ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Any OpenAI-compatible server (vLLM, LiteLLM, a local box ...)
# LLM_BASE_URL=http://localhost:11434/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=300

# --- Speech-to-text: mock | openai | groq | deepgram ---
STT_PROVIDER=openai
STT_MODEL=gpt-4o-transcribe
STT_API_KEY=
# Force Arabic (recommended; English callers are still detected by the agent from the text)
STT_LANGUAGE=ar
# Send the profile's stt_hints (business names, Gulf words) as recognition hints
STT_SEND_HINTS=true

# --- Text-to-speech: mock | openai | elevenlabs ---
TTS_PROVIDER=elevenlabs
TTS_MODEL=eleven_flash_v2_5
TTS_API_KEY=
# ElevenLabs voice_id (pick an Arabic / Gulf voice from the Voice Library) or OpenAI voice name
TTS_VOICE_AR=
TTS_VOICE_EN=
# OpenAI gpt-4o-mini-tts only: speaking style
# TTS_INSTRUCTIONS=Speak warm, natural Gulf (Emirati) Arabic like a friendly receptionist in Dubai.

# --- Booking summary to the caller: whatsapp | sms | whatsapp_then_sms | none ---
NOTIFY_CHANNEL=whatsapp_then_sms
# true = build and log the exact requests, send nothing. Set false in production.
NOTIFY_DRY_RUN=true
# WhatsApp Cloud API (Meta). The template must be approved: see examples/whatsapp_template.json
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=booking_confirmation_ar
WHATSAPP_TEMPLATE_LANG=ar
# SMS via Twilio: your registered alphanumeric sender ID or Twilio number
SMS_FROM=

# --- CRM / automation webhook (n8n, Zapier, Make, HubSpot, your backend) ---
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# --- Dashboard + storage ---
DASHBOARD_TOKEN=change-me
DB_PATH=voice_agent_ar.db

# --- Turn-taking (20 ms frames) ---
VAD_THRESHOLD=600
VAD_ENDPOINT_MS=600
BARGE_IN_MS=240
MAX_CALL_SECONDS=900
SUMMARY_ENABLED=true
